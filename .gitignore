# Build output
/build/
/out/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/*.sln
/*.vcxproj*

# Downloaded dependencies / local runtime packs
/external/
/streamline/
/Streamline/

# Runtime files that should not be committed
*.dll
*.exe
*.pdb
*.ilk
*.lib
*.exp
*.addon64
# ReShade.ini is generated at runtime; ReShade.ini.template is tracked instead.
ReShade.ini
ReShadePreset.ini
DLSSVideoPlayer.ini
DLSSVideoPlayer.log
ReShade.log

# Local archives / generated checksums
*.zip
*.7z
*.rar
*.sha256
*_SHA256.txt

# IDE / OS
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
.DS_Store

# experimental NR runtime, never committed
runtime/
external/
build/
*.log
ngx_logs/
models/

# Still frames captured from the camera; they contain whatever was in front of it.
captures/
